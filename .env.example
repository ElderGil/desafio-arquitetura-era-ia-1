# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Gateway (LiteLLM). Também não são segredos reais: só valem neste compose.
# A master key administra o gateway; a chave da aplicação é uma virtual key
# criada pelo gateway-init e é a única credencial que o serviço app recebe.
LITELLM_MASTER_KEY=sk-gateway-master-0001
HELPDESK_GATEWAY_KEY=sk-helpdesk-app-0001
GATEWAY_DB_PASSWORD=litellm-local

# Chaves do roteiro de governança do README (orçamento e limite mínimos).
ROTEIRO_ORCAMENTO_KEY=sk-roteiro-orcamento-0001
ROTEIRO_RPM_KEY=sk-roteiro-rpm-0001
